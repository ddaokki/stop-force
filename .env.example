# build.nvidia.com 에서 발급한 키 (nvapi- 로 시작)
NVIDIA_API_KEY=
# 사용할 모델 (build.nvidia.com 모델 페이지의 이름)
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# 요청당 60초, 재시도 최대 2회. 전체 에이전트 제한은 300초 (승인 대기 포함).
NVIDIA_REQUEST_TIMEOUT=60
NVIDIA_MAX_RETRIES=2
# 짧은 대화형 도구 호출 시연 기본값. 필요 시 사고 모드는 1로 설정.
NVIDIA_ENABLE_THINKING=0
NVIDIA_MAX_TOKENS=2048
